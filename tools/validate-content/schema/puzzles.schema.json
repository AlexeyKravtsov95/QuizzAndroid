{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poporyadku.app/schema/puzzles/v1",
  "title": "puzzles-NNN.json — пул головоломок контентного пакета «По порядку!»",
  "$comment": "ITERATION_4_DESIGN.md §4.3 (конверт, I4-D5) и §5.3. Перечисление sortKey ПОЛНОЕ: пять отложенных ключей (date, population, temperature, latitude, longitude) остаются в enum формата, а их запрет в паке v1 — семантическое правило R08C, а не удаление из схемы (I4-D24). Значение volatility «volatile» тоже остаётся в enum; запрещает его правило R09.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "puzzles"],
  "properties": {
    "schemaVersion": {
      "$comment": "Верхней границы здесь нет намеренно: её владелец — правило M01, сверяющее значение с SUPPORTED_SCHEMA_VERSION. Выдуманное «maximum» либо дублировало бы M01 вторым кодом, либо (в конвертах) подменяло бы точный M07 общим R01.",
      "type": "integer",
      "minimum": 1
    },
    "packId": {
      "$ref": "#/$defs/packId"
    },
    "puzzles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/puzzle"
      }
    }
  },
  "$defs": {
    "packId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 32
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date",
      "minLength": 10,
      "maxLength": 10
    },
    "cardId": {
      "type": "string",
      "pattern": "^c[1-4]$",
      "minLength": 2,
      "maxLength": 2
    },
    "sourceId": {
      "type": "string",
      "pattern": "^s\\d{1,2}$",
      "minLength": 2,
      "maxLength": 3
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardId", "title", "sortValue", "displayValue", "sourceIds"],
      "properties": {
        "cardId": {
          "$ref": "#/$defs/cardId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "sortValue": {
          "type": "number",
          "minimum": -1000000000000.0,
          "maximum": 1000000000000.0
        },
        "displayValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceId"
          }
        },
        "disputed": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "title", "kind", "accessedAt"],
      "$comment": "Правило 17: у источника обязателен url ИЛИ reference. Ветки anyOf — ограничения присутствия над тем же объектом, а не отдельные определения объекта, поэтому additionalProperties здесь не ставится: false в ветке запретил бы все остальные поля и отверг бы любой корректный источник. Закрытость объекта задана один раз — additionalProperties: false у самого source.",
      "anyOf": [
        {
          "type": "object",
          "required": ["url"]
        },
        {
          "type": "object",
          "required": ["reference"]
        }
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/sourceId"
        },
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "kind": {
          "type": "string",
          "enum": ["official", "encyclopedia", "academic", "other"]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "minLength": 12,
          "maxLength": 300
        },
        "reference": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        },
        "accessedAt": {
          "$ref": "#/$defs/isoDate"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "puzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "puzzleId",
        "category",
        "prompt",
        "sortKey",
        "sortDirection",
        "directionLabel",
        "cards",
        "correctOrder",
        "explanation",
        "sources",
        "volatility",
        "difficulty",
        "verifiedAt",
        "verifiedBy",
        "retiredIn"
      ],
      "properties": {
        "puzzleId": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9-]+-\\d{3}$",
          "minLength": 7,
          "maxLength": 48
        },
        "category": {
          "type": "string",
          "enum": [
            "history",
            "geography",
            "science",
            "nature",
            "culture",
            "russia",
            "mixed"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 90
        },
        "sortKey": {
          "type": "string",
          "enum": [
            "year",
            "date",
            "height",
            "depth",
            "length",
            "area",
            "population",
            "distance",
            "latitude",
            "longitude",
            "temperature",
            "mass",
            "speed",
            "duration"
          ]
        },
        "sortDirection": {
          "type": "string",
          "enum": ["ascending", "descending"]
        },
        "directionLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "cards": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "correctOrder": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/cardId"
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 40,
          "maxLength": 320
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "volatility": {
          "type": "string",
          "enum": ["stable", "slow", "volatile"]
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "verifiedAt": {
          "$ref": "#/$defs/isoDate"
        },
        "verifiedBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "retiredIn": {
          "$comment": "Верхней границы нет: её владелец — правило R18C, требующее retiredIn <= contentVersion пакета. Выдуманное «maximum» не дублировало бы R18C, а ПОДМЕНЯЛО его: находка схемы блокирует семантические правила файла, и точный R18C заменился бы общим R01.",
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    }
  }
}
