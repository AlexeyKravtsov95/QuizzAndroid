{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poporyadku.app/schema/daily-sets/v1",
  "title": "daily-sets-NNN.json — наборы контентного пакета «По порядку!»",
  "$comment": "ITERATION_4_DESIGN.md §4.3, §5.3. setIndex ограничен снизу нулём; непрерывность последовательности — семантическое правило R19, ссылочная целостность — R18/R18A/R18B.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "sets"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "packId": {
      "$ref": "#/$defs/packId"
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/set"
      }
    }
  },
  "$defs": {
    "packId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 32
    },
    "puzzleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+-[a-z0-9-]+-\\d{3}$",
      "minLength": 7,
      "maxLength": 48
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setIndex", "puzzleIds"],
      "properties": {
        "setIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "puzzleIds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/puzzleId"
          }
        }
      }
    }
  }
}
