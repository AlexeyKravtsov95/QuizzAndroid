<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Package visibility (API 30+): без этого объявления `resolveActivity` не видит
      установленный браузер, и SourceRow деградировал бы до `urlPlainText` даже там,
      где обработчик есть (COMPONENTS.md, «SourceRow»).

      Объявлены ровно две возможности: открыть http(s)-ссылку во внешнем приложении и
      открыть письмо «Сообщить о неточности» в почтовом клиенте (SENDTO mailto,
      ITERATION_5_DESIGN.md, §3.12): без этого объявления на API 30+ `canComposeEmail()`
      не видел бы ни одного клиента и действие пропало бы у всех.

      Разрешение INTERNET при этом НЕ требуется и не добавляется: сетевой запрос
      выполняет браузер, а письмо отправляет пользователь из своего клиента
      (UX_FLOW.md §5, IMPLEMENTATION_PLAN.md, итерация 7: «нет ни одного сетевого
      разрешения и ни одного сетевого вызова»).
    -->
    <!--
      Единственное разрешение приложения (ITERATION_6_DESIGN.md, §10.3, §10.4, I6-D41):
      показ напоминания на API 33+. Сетевых разрешений нет и не будет — ни INTERNET, ни
      локальных. ACCESS_NETWORK_STATE и остальные разрешения WorkManager приходят в
      итоговый манифест слиянием из библиотеки и НЕ удаляются: ACCESS_NETWORK_STATE —
      normal-разрешение на чтение состояния сети, доступа в сеть оно не даёт.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".PoPoRyadkuApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.PoPoRyadku"
        android:supportsRtl="false"
        tools:ignore="DataExtractionRules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PoPoRyadku">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Смена часового пояса и ручной перевод часов (ITERATION_6_DESIGN.md, §9.5,
          I6-D30). Оба действия входят в список исключений из ограничения неявных
          broadcast, поэтому приёмник из манифеста получает их и при незапущенном
          приложении — MainActivity для перепланирования не нужна.

          exported="false": системные broadcast приходят от системного uid и такому
          приёмнику доставляются; факт проверяется на эмуляторе (I6-M7).

          Приёмник смены ДАТЫ не заводится (I6-D31): полночь в открытом приложении уже
          закрыта минутным тикером Home и ON_START.
        -->
        <receiver
            android:name=".notifications.ReminderTimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
