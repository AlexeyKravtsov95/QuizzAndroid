    <!--
      Склонение выбирается по правилам ЛОКАЛИ УСТРОЙСТВА, а не по языку самих строк.
      На русской локали работают one/few/many; на нерусской доступны только one и other,
      поэтому other несёт форму «дней» — самую частую и нейтральную из трёх.
    -->
    <plurals name="streak_days">
        <item quantity="one">%d день</item>
        <item quantity="few">%d дня</item>
        <item quantity="many">%d дней</item>
        <item quantity="other">%d дней</item>
